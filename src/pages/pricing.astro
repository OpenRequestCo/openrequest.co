---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pricing" description="OpenRequest pricing — coming soon.">
  <section
    class="mx-auto w-full max-w-[80rem] px-[clamp(1.25rem,4vw,4.5rem)] py-[clamp(4rem,12vw,8rem)]"
    aria-labelledby="pricing-heading"
  >
    <p class="mb-3 text-sm font-medium tracking-wide text-blue uppercase">Pricing</p>
    <h1 id="pricing-heading" class="max-w-3xl font-display text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      Pricing
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-navy/70">
      Placeholder page. Plans and details will be added here.
    </p>
  </section>
</BaseLayout>
