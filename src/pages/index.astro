---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chapter from '../components/Chapter.astro';
import SectionRule from '../components/SectionRule.astro';
import Button from '../components/ui/Button.astro';
import TeamIcon from '../components/icons/TeamIcon.astro';
import SearchMoment from '../components/product/SearchMoment.astro';
import ConversationMoment from '../components/product/ConversationMoment.astro';
import HandlerMoment from '../components/product/HandlerMoment.astro';
import { EARLY_ACCESS_HREF } from '../consts';
import { story } from '../content/copy/story';
---

<BaseLayout>
  {/* Hero */}
  <section class="page-shell pt-20 pb-4 sm:pt-24 lg:pt-28">
    <div class="max-w-[44rem]">
      <h1 class="type-display">{story.hero.headline}</h1>
      <p class="type-lede mt-5 max-w-[40rem]">{story.hero.subhead}</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        <Button href={EARLY_ACCESS_HREF} variant="zinc">
          {story.hero.primaryCta}
        </Button>
        <a
          href="#how-it-works"
          class="text-sm font-medium text-ink-muted transition-colors hover:text-ink"
        >
          {story.hero.secondaryCta}
        </a>
      </div>
    </div>
    <div class="mt-12 w-full lg:mt-14">
      <SearchMoment />
    </div>
  </section>

  <SectionRule />

  {/* The idea — copy only; visuals live in the views below */}
  <Chapter id="how-it-works" eyebrow="The idea">
    <h2 class="type-title">{story.idea.headline}</h2>
    <p class="type-lede mt-5">{story.idea.body}</p>
  </Chapter>

  <SectionRule />

  {/* Employee view */}
  <Chapter id="employee-view" eyebrow={story.employee.eyebrow}>
    <h2 class="type-title">{story.employee.title}</h2>
    <p class="type-lede mt-5">{story.employee.body}</p>
    <ConversationMoment slot="visual" />
  </Chapter>

  <SectionRule />

  {/* Team view */}
  <Chapter id="team-view" eyebrow={story.team.eyebrow}>
    <h2 class="type-title">{story.team.title}</h2>
    <p class="type-lede mt-5">{story.team.body}</p>
    <HandlerMoment slot="visual" />
  </Chapter>

  <SectionRule />

  {/* Who this is for */}
  <Chapter id="audience" eyebrow={story.audience.eyebrow} measure="wide">
    <h2 class="type-title max-w-[40rem]">{story.audience.title}</h2>
    <p class="type-lede mt-5 max-w-[40rem]">{story.audience.body}</p>
    <ul class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        story.audience.teams.map((team) => (
          <li class="flex gap-3">
            <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg bg-zinc-100 text-zinc-600">
              <TeamIcon name={team.icon} />
            </span>
            <div>
              <p class="text-[0.9375rem] font-semibold tracking-tight text-ink">{team.name}</p>
              <p class="type-body mt-1 text-[0.875rem]">{team.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Chapter>

  <SectionRule />

  {/* Close */}
  <Chapter id="early-access" eyebrow="Early access">
    <h2 class="type-title">{story.close.title}</h2>
    <p class="type-lede mt-5">{story.close.body}</p>
    <p class="type-body mt-3">{story.close.detail}</p>
    <div class="mt-8">
      <Button href={EARLY_ACCESS_HREF} variant="zinc">
        {story.close.title}
      </Button>
    </div>
  </Chapter>

  <div id="sign-in" class="scroll-mt-24" hidden></div>
</BaseLayout>
