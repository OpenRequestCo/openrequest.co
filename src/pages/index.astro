---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chapter from '../components/Chapter.astro';
import Button from '../components/ui/Button.astro';
import SearchMoment from '../components/product/SearchMoment.astro';
import ConversationMoment from '../components/product/ConversationMoment.astro';
import HandlerMoment from '../components/product/HandlerMoment.astro';
import { EARLY_ACCESS_HREF } from '../consts';
import { story } from '../content/copy/story';
---

<BaseLayout>
  {/* Hero — title, copy, CTA, then the product moment (Linear rhythm) */}
  <section class="page-shell pt-12 pb-4 sm:pt-14 lg:pt-16">
    <div class="max-w-[36rem]">
      <h1 class="type-display">{story.hero.headline}</h1>
      <p class="type-lede mt-5">{story.hero.subhead}</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        <Button href={EARLY_ACCESS_HREF} variant="zinc">
          {story.hero.primaryCta}
        </Button>
        <a
          href="#how-it-works"
          class="text-sm font-medium text-ink-muted transition-colors hover:text-ink"
        >
          {story.hero.secondaryCta}
        </a>
      </div>
    </div>
    <div class="product-stage mt-12 lg:mt-14">
      <SearchMoment />
    </div>
  </section>

  {/* Problem — wider measure, two extremes as a clear contrast */}
  <Chapter id="problem" eyebrow="The problem" measure="wide">
    <h2 class="type-title">{story.problem.lead}</h2>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 sm:gap-12">
      {
        story.problem.extremes.map((item) => (
          <div>
            <p class="text-[1rem] font-semibold tracking-tight text-ink">{item.label}</p>
            <p class="type-body mt-2">{item.detail}</p>
          </div>
        ))
      }
    </div>
    <p class="type-body mt-10 max-w-[40rem]">{story.problem.body}</p>
    <p class="mt-5 max-w-[40rem] text-[1.0625rem] font-medium tracking-tight text-ink">
      {story.problem.turn}
    </p>
  </Chapter>

  {/* Idea — title + meaning + visual (not a feature list) */}
  <Chapter id="how-it-works" eyebrow="The idea">
    <h2 class="type-title">{story.idea.headline}</h2>
    <p class="type-lede mt-5">
      Employees describe what they need in a familiar interface. OpenRequest guides them to the
      right type of request, gathers the necessary context, and continues as a clean conversation —
      so when a human is needed, everything is already attached.
    </p>
    <p class="mt-5 text-[1.0625rem] font-medium tracking-tight text-ink">
      No ticket forms that feel like bureaucracy. No endless Slack threads. Just a clear,
      intentional loop.
    </p>
    <ConversationMoment slot="visual" />
  </Chapter>

  {/* Asking — one idea, one visual */}
  <Chapter id="asking">
    <h2 class="type-title">Closer to a conversation than a form</h2>
    <p class="type-lede mt-5">{story.loop.asking.body}</p>
    <SearchMoment slot="visual" />
  </Chapter>

  {/* Handling — one idea, one visual */}
  <Chapter id="handling">
    <h2 class="type-title">Context already attached</h2>
    <p class="type-lede mt-5">{story.loop.handling.body}</p>
    <p class="mt-4 text-[1.0625rem] font-medium tracking-tight text-ink">
      {story.loop.philosophy}
    </p>
    <HandlerMoment slot="visual" />
  </Chapter>

  {/* What it is not */}
  <Chapter id="not" eyebrow="What it is not" measure="wide">
    <h2 class="type-title max-w-[40rem]">Deliberately small</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-3 sm:gap-8">
      {
        story.not.items.map((item) => (
          <li class="text-[1.0625rem] font-semibold tracking-tight text-ink">{item}</li>
        ))
      }
    </ul>
    <p class="type-body mt-10 max-w-[40rem]">{story.not.body}</p>
  </Chapter>

  {/* Audience */}
  <Chapter id="audience" eyebrow="Who this is for">
    <h2 class="type-title">{story.audience.body}</h2>
    <p class="type-caption mt-10 mb-3">Common starting points</p>
    <p class="text-[0.9375rem] leading-relaxed text-ink-secondary">
      {story.audience.startingPoints.join(' · ')}
    </p>
  </Chapter>

  {/* Close */}
  <Chapter id="early-access" eyebrow="Early access">
    <h2 class="type-title">{story.close.title}</h2>
    <p class="type-lede mt-5">{story.close.body}</p>
    <p class="type-body mt-3">{story.close.detail}</p>
    <div class="mt-8">
      <Button href={EARLY_ACCESS_HREF} variant="zinc">
        {story.close.title}
      </Button>
    </div>
  </Chapter>

  <div id="sign-in" class="scroll-mt-24" hidden></div>
</BaseLayout>
