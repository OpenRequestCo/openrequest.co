---
/**
 * Two-column feature: copy left, stripped visual right.
 */
interface Props {
  id?: string
  eyebrow?: string
  title: string
  body: string
  class?: string
}

const { id, eyebrow, title, body, class: className } = Astro.props
---

<section id={id} class:list={['page-shell scroll-mt-24 py-14 sm:py-16 lg:py-20', className]}>
  {
    eyebrow && (
      <p class="type-caption mb-5">{eyebrow}</p>
    )
  }
  <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16 xl:gap-20">
    <div class="max-w-md">
      <h2 class="type-title">{title}</h2>
      <p class="type-lede mt-5">{body}</p>
    </div>
    <div class="min-w-0 lg:pt-1">
      <slot name="visual" />
    </div>
  </div>
</section>
