---
/**
 * Request properties panel — HTML/CSS product moment.
 */
import ProductFrame from './ProductFrame.astro';

interface Property {
  label: string;
  value: string;
  accent?: boolean;
}

interface Props {
  label?: string;
  title?: string;
  properties?: Property[];
}

const {
  label = 'Request details',
  title = 'New laptop for starting engineer',
  properties = [
    { label: 'Type', value: 'IT · Hardware' },
    { label: 'Status', value: 'Open', accent: true },
    { label: 'Owner', value: 'Alex' },
    { label: 'Start date', value: '7 April' },
    { label: 'Device', value: 'MacBook Pro' },
  ],
} = Astro.props;
---

<ProductFrame label={label}>
  <div class="rounded-[var(--radius-lg)] border border-border bg-canvas p-3 sm:p-4">
    <p class="text-[0.9375rem] font-medium text-ink">{title}</p>
    <dl class="mt-4 space-y-0 divide-y divide-border overflow-hidden rounded-[var(--radius-md)] border border-border bg-surface">
      {
        properties.map((property) => (
          <div class="flex items-center justify-between gap-4 px-3 py-2.5">
            <dt class="text-[0.75rem] text-ink-subtle">{property.label}</dt>
            <dd
              class:list={[
                'text-right text-[0.8125rem] font-medium',
                property.accent ? 'text-status-open' : 'text-ink',
              ]}
            >
              {property.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</ProductFrame>
