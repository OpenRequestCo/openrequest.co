---
/**
 * Quiet white stage for a single product moment in the narrative.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<figure
  class:list={[
    'overflow-hidden rounded-[var(--radius-xl)] border border-border bg-surface shadow-[var(--shadow-quiet)]',
    className,
  ]}
>
  <slot />
</figure>
