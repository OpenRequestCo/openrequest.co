---
/**
 * Stripped team view — one focused request row + properties, reveals on view.
 */
---

<figure
  class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-surface shadow-[var(--shadow-quiet)]"
  data-reveal
>
  <div
    class="flex flex-col gap-4 border-b border-zinc-100 px-5 py-4 opacity-0 translate-y-2 sm:flex-row sm:items-center sm:justify-between sm:px-6"
    data-reveal-item
  >
    <div class="min-w-0">
      <p class="truncate text-[0.9375rem] font-semibold tracking-tight text-ink">
        Set up a shared mailbox
      </p>
      <p class="mt-1 flex items-center gap-1.5 text-[0.75rem] text-zinc-500">
        <span class="size-1.5 rounded-full bg-status-open" aria-hidden="true"></span>
        Open · Nic · IT Help Desk
      </p>
    </div>
    <p class="shrink-0 text-[0.75rem] text-zinc-400">REQ-3</p>
  </div>

  <div class="grid gap-0 sm:grid-cols-3">
    <div
      class="border-b border-zinc-100 px-5 py-3.5 opacity-0 translate-y-2 sm:border-r sm:border-b-0 sm:px-6"
      data-reveal-item
    >
      <p class="text-[0.6875rem] font-medium tracking-wide text-zinc-400 uppercase">Assignee</p>
      <p class="mt-1 text-[0.875rem] font-medium text-ink">Rolo Rex</p>
    </div>
    <div
      class="border-b border-zinc-100 px-5 py-3.5 opacity-0 translate-y-2 sm:border-r sm:border-b-0 sm:px-6"
      data-reveal-item
    >
      <p class="text-[0.6875rem] font-medium tracking-wide text-zinc-400 uppercase">Type</p>
      <p class="mt-1 text-[0.875rem] font-medium text-ink">Mailbox</p>
    </div>
    <div class="px-5 py-3.5 opacity-0 translate-y-2 sm:px-6" data-reveal-item>
      <p class="text-[0.6875rem] font-medium tracking-wide text-zinc-400 uppercase">Context</p>
      <p class="mt-1 text-[0.875rem] font-medium text-ink">Members already listed</p>
    </div>
  </div>
</figure>
