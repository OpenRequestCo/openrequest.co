---
/**
 * Handler view — one composed product window (conversation + properties).
 * Not separate cards; mirrors the product’s quiet three-pane restraint.
 */
import ProductFrame from './ProductFrame.astro';
---

<ProductFrame>
  <div class="border-b border-border px-5 py-3.5 sm:px-6">
    <p class="text-[0.75rem] text-ink-subtle">Inbox · IT Help Desk · REQ-6</p>
    <h3 class="mt-1.5 text-[1.125rem] font-semibold tracking-tight text-ink sm:text-[1.25rem]">
      New laptop for starting engineer
    </h3>
    <p class="mt-1.5 flex items-center gap-2 text-[0.8125rem] text-ink-muted">
      <span class="size-1.5 rounded-full bg-status-open" aria-hidden="true"></span>
      Open · started by Jordan
    </p>
  </div>

  <div class="grid lg:grid-cols-[minmax(0,1fr)_13.5rem]">
    <div class="space-y-3 border-b border-border bg-canvas p-4 sm:p-5 lg:border-r lg:border-b-0">
      <p class="text-[0.75rem] font-semibold text-ink">Activity</p>
      <article class="rounded-[var(--radius-md)] border border-border bg-surface px-3.5 py-3">
        <p class="text-[0.75rem] font-medium text-ink">Jordan</p>
        <p class="mt-1.5 text-[0.8125rem] leading-relaxed text-ink-secondary">
          Monday 7 April. Standard MacBook Pro is fine.
        </p>
      </article>
      <article class="rounded-[var(--radius-md)] border border-border bg-surface px-3.5 py-3">
        <p class="text-[0.75rem] font-medium text-ink">Alex</p>
        <p class="mt-1.5 text-[0.8125rem] leading-relaxed text-ink-secondary">
          I’ll order this today and confirm delivery once it’s booked.
        </p>
      </article>
      <div class="rounded-[var(--radius-md)] border border-border bg-surface px-3.5 py-3">
        <p class="text-[0.8125rem] text-ink-subtle">Leave a comment…</p>
        <div class="mt-3 flex justify-end">
          <span class="rounded-[var(--radius-sm)] bg-accent px-2.5 py-1 text-[0.75rem] font-medium text-white">
            Comment
          </span>
        </div>
      </div>
    </div>

    <aside class="bg-surface px-4 py-4 sm:px-5">
      <p class="type-caption mb-3">Properties</p>
      <dl class="space-y-3 text-[0.8125rem]">
        <div class="flex items-baseline justify-between gap-3">
          <dt class="text-ink-subtle">Status</dt>
          <dd class="flex items-center gap-1.5 font-medium text-ink">
            <span class="size-1.5 rounded-full bg-status-open" aria-hidden="true"></span>
            Open
          </dd>
        </div>
        <div class="flex items-baseline justify-between gap-3">
          <dt class="text-ink-subtle">Raised by</dt>
          <dd class="font-medium text-ink">Jordan</dd>
        </div>
        <div class="flex items-baseline justify-between gap-3">
          <dt class="text-ink-subtle">Assignee</dt>
          <dd class="font-medium text-accent">Alex</dd>
        </div>
        <div class="flex items-baseline justify-between gap-3">
          <dt class="text-ink-subtle">Team</dt>
          <dd class="font-medium text-ink">IT Help Desk</dd>
        </div>
        <div class="flex items-baseline justify-between gap-3">
          <dt class="text-ink-subtle">Type</dt>
          <dd class="font-medium text-ink">Hardware</dd>
        </div>
      </dl>
    </aside>
  </div>
</ProductFrame>
