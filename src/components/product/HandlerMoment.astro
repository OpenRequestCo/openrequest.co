---
/**
 * Team view — handler intake, not the chat again.
 * Shows the request as it lands for a handler: who raised it, the ask in plain
 * text, and PROPERTIES from the product screenshot. No bubbles, no composer.
 */
---

<div
  class="grid w-full items-start gap-8 sm:grid-cols-[minmax(0,1fr)_11.5rem] sm:gap-0"
  data-reveal
>
  <div class="min-w-0 space-y-5 sm:pr-6">
    <div class="opacity-0 translate-y-2" data-reveal-item>
      <div class="flex items-baseline justify-between gap-3">
        <p class="text-[0.9375rem] font-semibold tracking-tight text-ink">Nic</p>
        <time class="shrink-0 text-[0.75rem] text-zinc-400">24 Aug, 13:33</time>
      </div>
      <p class="mt-3 text-[0.9375rem] leading-relaxed text-zinc-700 dark:text-zinc-300">
        Need to create a new mailbox called qa@openrequest.co and make me and Tommy and Alfie as
        members.
      </p>
    </div>

    <div class="opacity-0 translate-y-2" data-reveal-item>
      <button
        type="button"
        class="text-[0.875rem] font-medium text-accent hover:underline"
      >
        Assign to me
      </button>
    </div>
  </div>

  <aside
    class="border-t border-zinc-200 pt-5 opacity-0 translate-y-2 sm:border-t-0 sm:border-l sm:pt-0 sm:pl-5 dark:border-zinc-800"
    aria-label="Request properties"
    data-reveal-item
  >
    <p class="text-[11px] font-semibold tracking-[0.14em] text-zinc-400 uppercase">Properties</p>

    <dl class="mt-5 space-y-5 text-sm">
      <div>
        <dt class="text-zinc-500">Status</dt>
        <dd class="mt-1.5 flex items-center gap-2 font-medium text-ink">
          <span class="size-2.5 rounded-full bg-status-open" aria-hidden="true"></span>
          Open
        </dd>
      </div>
      <div>
        <dt class="text-zinc-500">Raised by</dt>
        <dd class="mt-1.5 font-medium text-ink">Nic</dd>
      </div>
      <div>
        <dt class="text-zinc-500">Assignee</dt>
        <dd class="mt-1.5">
          <button type="button" class="font-medium text-accent hover:underline">Assign to me</button>
        </dd>
      </div>
      <div>
        <dt class="text-zinc-500">Team</dt>
        <dd class="mt-1.5 font-medium text-ink">IT Help Desk</dd>
      </div>
    </dl>
  </aside>
</div>
