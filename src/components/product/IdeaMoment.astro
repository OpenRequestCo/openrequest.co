---
/**
 * Stripped idea visual — command palette fragment only (not the full portal).
 * Animates when scrolled into view.
 */
---

<figure
  class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-surface shadow-[var(--shadow-quiet)]"
  data-palette
  data-palette-await-view
>
  <div class="flex items-center gap-3 px-4 py-3.5 sm:px-5">
    <span class="text-zinc-400" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
        <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
        <path
          d="M10.5 10.5L13.5 13.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </span>
    <p class="min-w-0 flex-1 text-[0.9375rem] text-ink" aria-live="polite">
      <span data-palette-text></span><span
        data-palette-caret
        class="ml-0.5 inline-block h-[1.05em] w-px translate-y-[0.1em] bg-ink align-middle opacity-0"
        aria-hidden="true"></span>
    </p>
    <span
      data-palette-clear
      class="flex size-5 items-center justify-center rounded-full bg-zinc-100 text-zinc-400 opacity-0 transition-opacity"
      aria-hidden="true"
    >
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
        <path d="M2 2l6 6M8 2L2 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
        ></path>
      </svg>
    </span>
  </div>

  <ul data-palette-results class="hidden space-y-0.5 border-t border-zinc-100 px-2 py-2 sm:px-2.5">
    <li>
      <button
        type="button"
        tabindex="-1"
        class="flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left transition-colors hover:bg-zinc-100"
        data-palette-row
        style="opacity:0; transform: translateY(4px);"
      >
        <span
          class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-zinc-50 text-[0.75rem] font-semibold text-ink ring-1 ring-zinc-200/80"
          >O</span
        >
        <span class="min-w-0">
          <span class="block text-[0.875rem] font-semibold text-ink">Order a new MacBook laptop</span>
          <span class="mt-0.5 block text-[0.8125rem] text-zinc-500">Order a MacBook Pro</span>
        </span>
      </button>
    </li>
    <li>
      <button
        type="button"
        tabindex="-1"
        class="flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left transition-colors hover:bg-zinc-100"
        data-palette-row
        style="opacity:0; transform: translateY(4px);"
      >
        <span
          class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-zinc-50 text-[0.75rem] font-semibold text-ink ring-1 ring-zinc-200/80"
          >O</span
        >
        <span class="min-w-0">
          <span class="block text-[0.875rem] font-semibold text-ink">Order a new Windows laptop</span>
          <span class="mt-0.5 block text-[0.8125rem] text-zinc-500">Order a Windows laptop</span>
        </span>
      </button>
    </li>
  </ul>
</figure>
