---
/**
 * Stripped employee conversation — bubbles only, animates in on view.
 */
---

<figure
  class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-canvas p-5 shadow-[var(--shadow-quiet)] sm:p-6"
  data-reveal
>
  <div class="mx-auto max-w-lg space-y-3">
    <div
      class="ml-auto max-w-[85%] rounded-2xl bg-accent px-4 py-3 text-white opacity-0 translate-y-2"
      data-reveal-item
    >
      <p class="text-[0.6875rem] font-medium text-white/75">You</p>
      <p class="mt-1 text-[0.875rem] leading-relaxed">
        Need a shared mailbox for qa@openrequest.co with me, Tommy, and Alfie as members.
      </p>
    </div>
    <div
      class="mr-auto max-w-[85%] rounded-2xl bg-zinc-100 px-4 py-3 text-ink opacity-0 translate-y-2"
      data-reveal-item
    >
      <p class="text-[0.6875rem] font-medium text-zinc-500">Rolo Rex · IT Help Desk</p>
      <p class="mt-1 text-[0.875rem] leading-relaxed text-zinc-700">
        On it — creating the mailbox now and will delegate access once it’s ready.
      </p>
    </div>
  </div>
</figure>
