---
/**
 * Command-palette start: types “New laptop…”, then reveals laptop request matches.
 */
---

<figure
  class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-surface shadow-[var(--shadow-quiet)]"
  data-palette
>
  <div class="flex items-center gap-3 border-b border-zinc-100 px-4 py-3.5 sm:px-5">
    <span class="text-zinc-400" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
        <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
        <path
          d="M10.5 10.5L13.5 13.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </span>
    <p class="min-w-0 flex-1 text-[0.9375rem] text-ink" aria-live="polite">
      <span data-palette-text></span><span
        data-palette-caret
        class="ml-0.5 inline-block h-[1.05em] w-px translate-y-[0.1em] bg-ink align-middle opacity-0"
        aria-hidden="true"></span>
    </p>
    <span
      data-palette-clear
      class="flex size-5 items-center justify-center rounded-full bg-zinc-100 text-zinc-400 opacity-0 transition-opacity"
      aria-hidden="true"
    >
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
        <path d="M2 2l6 6M8 2L2 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
        ></path>
      </svg>
    </span>
  </div>

  <ul data-palette-results class="space-y-1 px-2 py-2 opacity-0 transition-opacity duration-300 sm:px-2.5">
    <li
      class="flex items-start gap-3 rounded-xl bg-zinc-100 px-3 py-2.5"
      data-palette-row
      style="opacity:0; transform: translateY(4px);"
    >
      <span
        class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-surface text-[0.75rem] font-semibold text-ink shadow-sm ring-1 ring-zinc-200/80"
        >O</span
      >
      <span class="min-w-0">
        <span class="block text-[0.875rem] font-semibold text-ink">Order a new MacBook laptop</span>
        <span class="mt-0.5 block text-[0.8125rem] text-zinc-500">Order a MacBook Pro</span>
      </span>
    </li>
    <li
      class="flex items-start gap-3 rounded-xl px-3 py-2.5"
      data-palette-row
      style="opacity:0; transform: translateY(4px);"
    >
      <span
        class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-surface text-[0.75rem] font-semibold text-ink shadow-sm ring-1 ring-zinc-200/80"
        >O</span
      >
      <span class="min-w-0">
        <span class="block text-[0.875rem] font-semibold text-ink">Order a new Windows laptop</span>
        <span class="mt-0.5 block text-[0.8125rem] text-zinc-500">Order a Windows laptop</span>
      </span>
    </li>
  </ul>
</figure>

<script>
  function runPalette(root: HTMLElement) {
    const textEl = root.querySelector<HTMLElement>('[data-palette-text]');
    const caret = root.querySelector<HTMLElement>('[data-palette-caret]');
    const clear = root.querySelector<HTMLElement>('[data-palette-clear]');
    const results = root.querySelector<HTMLElement>('[data-palette-results]');
    const rows = root.querySelectorAll<HTMLElement>('[data-palette-row]');
    if (!textEl || !caret || !clear || !results) return;

    const phrase = 'New laptop...';
    let i = 0;

    caret.style.opacity = '1';
    caret.style.animation = 'palette-blink 1s step-end infinite';

    const typeTimer = window.setInterval(() => {
      i += 1;
      textEl.textContent = phrase.slice(0, i);
      if (i >= phrase.length) {
        window.clearInterval(typeTimer);
        clear.style.opacity = '1';
        results.style.opacity = '1';
        rows.forEach((row, index) => {
          window.setTimeout(() => {
            row.style.transition = 'opacity 280ms ease, transform 280ms ease';
            row.style.opacity = '1';
            row.style.transform = 'translateY(0)';
          }, 80 + index * 120);
        });
      }
    }, 55);
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-palette]').forEach(runPalette);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  @keyframes palette-blink {
    50% {
      opacity: 0;
    }
  }
</style>
