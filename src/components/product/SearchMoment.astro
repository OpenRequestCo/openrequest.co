---
/**
 * Employee start screen: How can we help + typing search → matches + Your requests.
 * Typing animation starts only when scrolled into view.
 */
---

<figure
  class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-surface shadow-[var(--shadow-quiet)]"
  data-palette
  data-palette-await-view
>
  <div class="border-b border-zinc-100 bg-surface px-5 py-5 sm:px-6">
    <p class="text-[0.75rem] font-medium text-accent">OpenRequest</p>
    <h3 class="mt-2 text-[1.375rem] font-semibold tracking-tight text-ink sm:text-[1.5rem]">
      How can we help?
    </h3>
    <p class="mt-1.5 text-[0.875rem] text-zinc-500">
      Describe what you need — we’ll guide the rest.
    </p>
  </div>

  <div class="bg-canvas px-4 py-5 sm:px-6 sm:py-6">
    <div
      class="overflow-hidden rounded-2xl border border-zinc-200/80 bg-surface shadow-[var(--shadow-quiet)]"
    >
      <div class="flex items-center gap-3 px-4 py-3.5">
        <span class="text-zinc-400" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
            <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
            <path
              d="M10.5 10.5L13.5 13.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <p class="min-w-0 flex-1 text-[0.9375rem] text-ink" aria-live="polite">
          <span data-palette-text></span><span
            data-palette-caret
            class="ml-0.5 inline-block h-[1.05em] w-px translate-y-[0.1em] bg-ink align-middle opacity-0"
            aria-hidden="true"></span>
        </p>
        <span
          data-palette-clear
          class="flex size-5 items-center justify-center rounded-full bg-zinc-100 text-zinc-400 opacity-0 transition-opacity"
          aria-hidden="true"
        >
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path
              d="M2 2l6 6M8 2L2 8"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"></path>
          </svg>
        </span>
      </div>

      <ul
        data-palette-results
        class="hidden space-y-0.5 border-t border-zinc-100 px-2 py-2 sm:px-2.5"
      >
        <li>
          <button
            type="button"
            tabindex="-1"
            class="flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left transition-colors hover:bg-zinc-100 focus-visible:bg-zinc-100"
            data-palette-row
            style="opacity:0; transform: translateY(4px);"
          >
            <span
              class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-zinc-50 text-[0.75rem] font-semibold text-ink ring-1 ring-zinc-200/80"
              >O</span
            >
            <span class="min-w-0">
              <span class="block text-[0.875rem] font-semibold text-ink"
                >Order a new MacBook laptop</span
              >
              <span class="mt-0.5 block text-[0.8125rem] text-zinc-500">Order a MacBook Pro</span>
            </span>
          </button>
        </li>
        <li>
          <button
            type="button"
            tabindex="-1"
            class="flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left transition-colors hover:bg-zinc-100 focus-visible:bg-zinc-100"
            data-palette-row
            style="opacity:0; transform: translateY(4px);"
          >
            <span
              class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-zinc-50 text-[0.75rem] font-semibold text-ink ring-1 ring-zinc-200/80"
              >O</span
            >
            <span class="min-w-0">
              <span class="block text-[0.875rem] font-semibold text-ink"
                >Order a new Windows laptop</span
              >
              <span class="mt-0.5 block text-[0.8125rem] text-zinc-500">Order a Windows laptop</span>
            </span>
          </button>
        </li>
        <li>
          <button
            type="button"
            tabindex="-1"
            class="flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left transition-colors hover:bg-zinc-100 focus-visible:bg-zinc-100"
            data-palette-row
            style="opacity:0; transform: translateY(4px);"
          >
            <span
              class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-[0.875rem] font-semibold text-accent"
              >+</span
            >
            <span class="min-w-0">
              <span class="block text-[0.875rem] font-semibold text-ink">Something else</span>
              <span class="mt-0.5 block text-[0.8125rem] text-zinc-500">Start a free-form request</span>
            </span>
          </button>
        </li>
      </ul>
    </div>

    <div class="mt-6">
      <p class="mb-2 text-[0.8125rem] text-zinc-500">Your requests</p>
      <ul class="overflow-hidden rounded-xl border border-zinc-200/80 bg-surface">
        <li class="flex items-start justify-between gap-4 border-b border-zinc-100 px-4 py-3">
          <div class="min-w-0">
            <p class="truncate text-[0.875rem]">
              <span class="text-zinc-400">REQ-8</span>
              <span class="ml-2 font-medium text-ink">Create an email distribution list</span>
            </p>
            <p class="mt-0.5 flex items-center gap-1.5 text-[0.75rem] text-zinc-500">
              <span class="size-1.5 rounded-full bg-status-open" aria-hidden="true"></span>
              Open · IT Help Desk
            </p>
          </div>
          <time class="shrink-0 text-[0.75rem] text-zinc-400">25 Aug</time>
        </li>
        <li class="flex items-start justify-between gap-4 px-4 py-3">
          <div class="min-w-0">
            <p class="truncate text-[0.875rem]">
              <span class="text-zinc-400">REQ-4</span>
              <span class="ml-2 font-medium text-ink">Request access to VPN</span>
            </p>
            <p class="mt-0.5 text-[0.75rem] text-zinc-500">Resolved · Network</p>
          </div>
          <time class="shrink-0 text-[0.75rem] text-zinc-400">22 Aug</time>
        </li>
      </ul>
    </div>
  </div>
</figure>

