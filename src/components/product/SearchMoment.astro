---
/**
 * Employee portal — starting a request (command-palette search).
 * Matches product: soft canvas inset, pill search, quiet request list below.
 */
import ProductFrame from './ProductFrame.astro';
---

<ProductFrame>
  <div class="border-b border-border bg-surface px-5 py-4 sm:px-6">
    <p class="text-[0.75rem] font-medium text-accent">OpenRequest</p>
    <h3 class="mt-2 text-[1.375rem] font-semibold tracking-tight text-ink sm:text-[1.5rem]">
      How can we help?
    </h3>
    <p class="mt-1.5 text-[0.875rem] text-ink-muted">
      Describe what you need — we’ll guide the rest.
    </p>
  </div>

  <div class="bg-canvas px-4 py-5 sm:px-6 sm:py-6">
    <div
      class="flex items-center gap-3 rounded-[var(--radius-pill)] border border-border bg-surface px-4 py-3 shadow-[var(--shadow-quiet)]"
      role="presentation"
    >
      <span class="text-ink-subtle" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
          <path
            d="M10.5 10.5L13.5 13.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </span>
      <p class="min-w-0 flex-1 truncate text-[0.9375rem] text-ink">
        New laptop for starting engineer
        <span class="ml-0.5 inline-block h-4 w-px animate-pulse bg-accent align-middle" aria-hidden="true"
        ></span>
      </p>
    </div>

    <div class="mt-6">
      <p class="mb-2 text-[0.8125rem] text-ink-muted">Your requests</p>
      <ul class="overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface">
        <li class="flex items-start justify-between gap-4 border-b border-border px-4 py-3">
          <div class="min-w-0">
            <p class="truncate text-[0.875rem]">
              <span class="text-ink-subtle">REQ-6</span>
              <span class="ml-2 font-medium text-ink">New laptop for starting engineer</span>
            </p>
            <p class="mt-0.5 flex items-center gap-1.5 text-[0.75rem] text-ink-muted">
              <span class="size-1.5 rounded-full bg-status-open" aria-hidden="true"></span>
              Open · IT Help Desk
            </p>
          </div>
          <time class="shrink-0 text-[0.75rem] text-ink-subtle">25 Aug</time>
        </li>
        <li class="flex items-start justify-between gap-4 px-4 py-3">
          <div class="min-w-0">
            <p class="truncate text-[0.875rem]">
              <span class="text-ink-subtle">REQ-4</span>
              <span class="ml-2 font-medium text-ink">Access to design files</span>
            </p>
            <p class="mt-0.5 text-[0.75rem] text-ink-muted">Resolved · Internal tools</p>
          </div>
          <time class="shrink-0 text-[0.75rem] text-ink-subtle">22 Aug</time>
        </li>
      </ul>
    </div>
  </div>
</ProductFrame>
