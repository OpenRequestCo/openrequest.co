---
/**
 * Command-palette / search start — HTML/CSS product moment.
 */
import ProductFrame from './ProductFrame.astro';

interface Props {
  label?: string;
  placeholder?: string;
  query?: string;
}

const {
  label = 'Start a request',
  placeholder = 'What do you need help with?',
  query = 'New laptop for starting engineer',
} = Astro.props;
---

<ProductFrame label={label}>
  <div
    class="rounded-[var(--radius-lg)] border border-border-strong bg-canvas px-3.5 py-3 shadow-[inset_0_1px_0_rgb(255_255_255_/_0.7)]"
    role="presentation"
  >
    <div class="flex items-center gap-3">
      <span
        class="flex size-8 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-accent-soft text-accent"
        aria-hidden="true"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M10.5 10.5L13.5 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
          ></path>
        </svg>
      </span>
      <p class="min-w-0 flex-1 truncate text-[0.9375rem] text-ink">
        {query}
        <span class="ml-0.5 inline-block h-4 w-px animate-pulse bg-accent align-middle" aria-hidden="true"
        ></span>
      </p>
      <kbd
        class="hidden rounded border border-border bg-surface px-1.5 py-0.5 font-sans text-[0.6875rem] text-ink-subtle sm:inline"
      >
        ⌘K
      </kbd>
    </div>
    <p class="mt-3 border-t border-border pt-3 text-[0.8125rem] text-ink-subtle">
      {placeholder}
    </p>
  </div>
</ProductFrame>
