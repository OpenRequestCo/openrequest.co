---
/**
 * Corner plus for grid frames — centred on the corner so the stroke
 * shares the border’s centre line.
 */
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<svg
  class:list={['pointer-events-none absolute z-10 size-[18px] text-zinc-300 dark:text-zinc-600', className]}
  width="18"
  height="18"
  viewBox="0 0 18 18"
  fill="none"
  aria-hidden="true"
>
  <path d="M9 1V17M1 9H17" stroke="currentColor" stroke-width="1" stroke-linecap="square"></path>
</svg>
