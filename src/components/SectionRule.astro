---
/**
 * Full-bleed hairline across the viewport.
 * Pluses sit exactly on the page-shell (container) edges.
 */
---

<div class="relative w-full" aria-hidden="true">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-zinc-200"></div>
  <div class="page-shell relative h-0">
    <span
      class="absolute top-0 left-0 z-10 -translate-x-1/2 -translate-y-1/2 select-none font-normal text-[0.8125rem] leading-none text-zinc-300"
      >+</span
    >
    <span
      class="absolute top-0 right-0 z-10 translate-x-1/2 -translate-y-1/2 select-none font-normal text-[0.8125rem] leading-none text-zinc-300"
      >+</span
    >
  </div>
</div>
