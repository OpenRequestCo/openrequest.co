---
/** Drafting-style section rule: hairline with pluses at the content edges. */
---

<div class="section-rule" aria-hidden="true">
  <div class="page-shell relative">
    <div class="h-px w-full bg-zinc-200"></div>
    <span
      class="absolute top-0 left-0 flex size-3 -translate-x-1/2 -translate-y-1/2 items-center justify-center text-[0.75rem] leading-none text-zinc-300"
    >+</span
    >
    <span
      class="absolute top-0 right-0 flex size-3 translate-x-1/2 -translate-y-1/2 items-center justify-center text-[0.75rem] leading-none text-zinc-300"
    >+</span
    >
  </div>
</div>
