---
import Button from './ui/Button.astro';
import { NAV_ITEMS, SITE_TITLE } from '../consts';
---

<header class="sticky top-0 z-40 border-b border-border bg-canvas/90 backdrop-blur-md">
  <div class="page-shell flex items-center justify-between gap-6 py-3.5">
    <a class="shrink-0" href="/" aria-label={`${SITE_TITLE}, home`}>
      <img
        src="/images/symbol-wordmark-horizontal.svg"
        alt={SITE_TITLE}
        width="148"
        height="30"
        class="h-7 w-auto"
      />
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      {
        NAV_ITEMS.map((item) => {
          if (item.emphasis === 'primary') {
            return (
              <Button href={item.href} variant="primary" class="text-[0.8125rem] sm:text-sm">
                {item.label}
              </Button>
            );
          }

          const ghostClass = [
              'text-[0.8125rem] sm:text-sm',
              item.emphasis === 'secondary' ? 'hidden sm:inline-flex' : '',
            ]
              .filter(Boolean)
              .join(' ');

          return (
            <Button href={item.href} variant="ghost" class={ghostClass}>
              {item.label}
            </Button>
          );
        })
      }
    </nav>
  </div>
</header>
