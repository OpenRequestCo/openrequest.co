---
/**
 * Header: logo left, quiet links + dark zinc CTA on the right.
 */
import { EARLY_ACCESS_HREF, NAV_ITEMS, SIGN_IN_HREF, SITE_TITLE } from '../consts';

const pricing = NAV_ITEMS.find((item) => item.label === 'Pricing');
---

<header class="sticky top-0 z-40 border-b border-border bg-canvas/90 backdrop-blur-md">
  <div class="page-shell flex items-center justify-between gap-6 py-3.5">
    <a href="/" class="shrink-0" aria-label={`${SITE_TITLE}, home`}>
      <img
        src="/images/symbol-wordmark-horizontal.svg"
        alt={SITE_TITLE}
        width="138"
        height="28"
        class="h-[1.375rem] w-auto"
      />
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      {
        pricing && (
          <a
            href={pricing.href}
            class="px-2.5 py-1.5 text-[0.8125rem] font-medium text-ink-muted transition-colors hover:text-ink"
          >
            {pricing.label}
          </a>
        )
      }
      <a
        href={SIGN_IN_HREF}
        class="hidden px-2.5 py-1.5 text-[0.8125rem] font-medium text-ink-muted transition-colors hover:text-ink sm:inline"
      >
        Sign in
      </a>
      <a
        href={EARLY_ACCESS_HREF}
        class="ml-1 inline-flex items-center rounded-[var(--radius-md)] bg-zinc-900 px-3 py-1.5 text-[0.8125rem] font-medium text-white transition-colors hover:bg-zinc-800"
      >
        Get early access
      </a>
    </nav>
  </div>
</header>
