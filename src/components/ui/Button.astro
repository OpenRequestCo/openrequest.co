---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'text';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;

const classes = [
  'inline-flex items-center justify-center gap-1.5 text-sm font-medium transition-colors duration-150',
  variant === 'primary' &&
    'rounded-[var(--radius-md)] bg-accent px-3.5 py-2 text-white hover:bg-accent-hover',
  variant === 'secondary' &&
    'rounded-[var(--radius-md)] border border-border-strong bg-surface px-3.5 py-2 text-ink hover:bg-surface-muted',
  variant === 'text' && 'text-ink-muted hover:text-ink',
  className,
];

const Tag = href ? 'a' : 'button';
---

<Tag href={href} type={href ? undefined : 'button'} class:list={classes}>
  <slot />
</Tag>
