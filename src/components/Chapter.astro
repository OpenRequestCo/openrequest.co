---
/**
 * Story section: title + copy, then an optional full-width visual.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  class?: string;
  measure?: 'narrow' | 'readable' | 'wide' | 'full';
  /** Tighter vertical padding for chapters inside a continuous band. */
  tight?: boolean;
}

const { id, eyebrow, class: className, measure = 'readable', tight = false } = Astro.props;

const measureClass = {
  narrow: 'max-w-[32rem]',
  readable: 'max-w-[42rem]',
  wide: 'max-w-[52rem]',
  full: 'max-w-none',
}[measure];
---

<section
  id={id}
  class:list={[
    'page-shell',
    tight ? 'py-10 sm:py-12 lg:py-14' : 'py-[var(--spacing-chapter)]',
    className,
  ]}
>
  {
    eyebrow && (
      <p class="type-caption mb-4">{eyebrow}</p>
    )
  }
  <div class={measureClass}>
    <slot />
  </div>
  {
    Astro.slots.has('visual') && (
      <div class="mt-10 w-full lg:mt-12">
        <slot name="visual" />
      </div>
    )
  }
</section>
