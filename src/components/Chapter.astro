---
/**
 * Sequential story chapter.
 * Prose leads; optional visual slot follows in the reading flow (never a card grid).
 */
interface Props {
  id?: string;
  eyebrow?: string;
  class?: string;
  compact?: boolean;
  /** Stretch content to page width (for composed product stages). */
  wide?: boolean;
}

const { id, eyebrow, class: className, compact = false, wide = false } = Astro.props;
---

<section
  id={id}
  class:list={[
    'page-shell',
    compact ? 'py-[var(--spacing-chapter-sm)]' : 'py-[var(--spacing-chapter)]',
    className,
  ]}
>
  {
    eyebrow && (
      <p class="type-caption mb-5">{eyebrow}</p>
    )
  }
  <div class:list={[wide ? 'max-w-none' : 'max-w-[var(--max-width-prose)]']}>
    <slot />
  </div>
  {
    Astro.slots.has('visual') && (
      <div class="product-stage mt-10 lg:mt-12">
        <slot name="visual" />
      </div>
    )
  }
</section>
