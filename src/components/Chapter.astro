---
/**
 * Story section: title + copy, then an optional full-width visual.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  class?: string;
  measure?: 'narrow' | 'readable' | 'wide';
}

const { id, eyebrow, class: className, measure = 'readable' } = Astro.props;

const measureClass = {
  narrow: 'max-w-[32rem]',
  readable: 'max-w-[42rem]',
  wide: 'max-w-[52rem]',
}[measure];
---

<section
  id={id}
  class:list={['page-shell py-[var(--spacing-chapter)]', className]}
>
  {
    eyebrow && (
      <p class="type-caption mb-4">{eyebrow}</p>
    )
  }
  <div class={measureClass}>
    <slot />
  </div>
  {
    Astro.slots.has('visual') && (
      <div class="mt-10 w-full lg:mt-12">
        <slot name="visual" />
      </div>
    )
  }
</section>
